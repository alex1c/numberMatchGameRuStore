{
  "name": "number-match",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "solver:bench": "tsx src/game/solver/bench.ts",
    "generator:audit": "tsx src/game/generator/auditCli.ts",
    "generator:audit:gv3": "tsx src/game/generator/auditCli.ts -- --gv3 --density all",
    "campaign:build": "tsx src/game/campaign/builderCli.ts",
    "campaign:audit": "tsx src/game/campaign/auditCli.ts",
    "android:qa": "powershell -ExecutionPolicy Bypass -File ./scripts/android/android-device-qa.ps1"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.25",
    "expo-linking": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^24.5.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
